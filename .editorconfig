# hana editor settings
# Whitespace conventions follow zigfmt (4-space) and the repo's lf endings.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.zig]
# Pin the zigfmt contract so editors don't fight `zig fmt` on block indents
# or strips. zigfmt is 4-space and never tabs; these match `[*]` and exist
# only to make the language-specific intent explicit.
indent_style = space
indent_size = 4
end_of_line = lf