# single-dir codebase
dev/codebase/*

# zig garbage
.zig-cache/
zig-out/

# make garbage
*.orig
*.rej

# vim garbage
# .swp: swap file for the file itself; .*.sw[a-p]: swaps for hidden files
# (vim mangles the name, prefixing a dot) plus the .swa-.swp recovery range.
.swp
.*.sw[a-p]

# other garbage
*.xml

# local development tooling state (opencode goals, node_modules, package files)
.opencode/

# harness run artifacts (regenerated locally; only golden/ is tracked)
dev/harness/out/
dev/harness/.cache/
