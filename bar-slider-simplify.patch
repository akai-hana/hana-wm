-    const n: usize = if (channels > 32) 32 else @as(usize, channels);
-    if (n == 0) return false;
-    if (out.len < 4 + n * 4) return false;
-    @memset(out[0 .. 4 + n * 4], 0);
-    out[0] = @intCast(n);
-    const v: u32 = slider.rawFromPct(u32, pct, 0, PA_VOLUME_NORM);
-    for (0..n) |i| writeLE(u32, out, 4 + i * 4, v);
-    return true;
-}
