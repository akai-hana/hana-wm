@startuml
'!theme plain
skinparam packageStyle rectangle
skinparam backgroundColor #1a1b26
skinparam defaultFontColor #c0caf5
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0

skinparam classBackgroundColor #24283b
skinparam classBorderColor #414868
skinparam classHeaderBackgroundColor #2f3347
skinparam packageBorderColor #414868
skinparam packageBackgroundColor #1a1b26
skinparam arrowColor #565f89
skinparam arrowFontColor #565f89
skinparam arrowFontSize 9

' ══════════════════════════════════════════════════════════
' CORE
' ══════════════════════════════════════════════════════════
package "core" {
  class State_core <<core>> {
    - conn: Connection
    - screen: Screen
    - root: WindowId
    - alloc: Allocator
    - config: *Config
    --
    + init(conn, screen, root, alloc, config)
    + getState(): *State
  }

  class WorkspaceId <<core>> {
    - index: u8
    --
    + fromIndex(i: u8): WorkspaceId
    + eql(other): bool
  }

  enum FocusSuppressReason <<core>> {
    none
    window_spawn
    tiling_operation
  }

  class Connection <<core>> {
    alias = xcb.xcb_connection_t
  }

  class WindowId <<core>> {
    alias = u32
  }
}

' ══════════════════════════════════════════════════════════
' MODEL
' ══════════════════════════════════════════════════════════
package "model" {
  class Model <<model>> {
    + store: StoreT
    + ws: [64]WsState
    + current: WSId
    + focused: ?WindowId
    + all_view_active: bool
    + next_seq: u32
    + count_minimized: u32
    --
    + register(win, hint_ws)
    + unregister(win)
    + minimize(win)
    + restore(win)
    + moveWindowToWs(win, ws)
    + tagRemove / tagAdd
    + pinToggle(win)
    + cycleLayout(dir)
    + adjustMasterWidth(delta)
    + setFocus / clearFocus
    + visibleOn(win, ws): bool
    + findHome(win): ?WSId
    + toggleFullscreen(win): bool
    + setFloatingRect(win, rect)
    + fallbackFocusCandidate(ws)
    + fullscreenOccupantOnWs(ws)
    + honorConfigureRequest(win, req)
    + applyConfigReload(tpl)
    + swapMaster / reorderTiled
    + allViewToggle(): bool
  }

  class Entry <<model>> {
    + mask: Mask
    + mode: Mode
    + size_hints: SizeHints
    + home_ws: ?WSId
  }

  class Mode <<model>> {
    base: BaseMode
    fullscreen: FullscreenPayload
    minimized: MinimizedPayload
  }

  class BaseMode <<model>> {
    tiled
    floating: Rect
  }

  class WsState <<model>> {
    + tiled_order: OrderList
    + focus_mru: MruList
    + params: LayoutParams
  }

  class SizeHints <<model>> {
    + max_width: u16
    + max_height: u16
    + inc_width: u16
    + inc_height: u16
    + min_aspect: f32
    + max_aspect: f32
  }

  class LayoutParams <<model>> {
    + kind: LayoutKind
    + variant_idx: u8
    + master_width: f32
    + master_count: u8
    + stack_balance: f32
    + scroll_offset: i32
    + scroll_prev_count: u32
  }

  enum LayoutKind <<model>> {
    master
    monocle
    grid
    fibonacci
    leaf
    scroll
  }

  class FullscreenPayload <<model>> {
    + ws: WSId
    + base: BaseMode
  }

  class MinimizedPayload <<model>> {
    + prev: PrevMode
    + slot: ?usize
    + seq: u32
  }

  class ConfigureReq <<model>> {
    + x: ?i16
    + y: ?i16
    + width: ?u16
    + height: ?u16
    + border_width: ?u16
  }

  class StoreT <<model>> {
    Store(WindowId, Entry, 128)
    --
    + put(k, v): *Entry
    + remove(k): bool
    + has(k): bool
    + get(k): ?Entry
    + getPtr(k): ?*Entry
    + at(i): Item
    + count(): usize
  }

  class OrderList <<model>> {
    BoundedList(WindowId, max_tiled)
  }

  class MruList <<model>> {
    BoundedList(WindowId, 16)
  }
}

' ══════════════════════════════════════════════════════════
' CONFIG
' ══════════════════════════════════════════════════════════
package "config" {
  class Config <<config>> {
    + keybindings: ArrayList(Keybind)
    + mouse_bindings: ArrayList(MouseBind)
    + tiling: TilingConfig
    + workspaces: WorkspaceConfig
    + bar: BarConfig
    + keybind_resolver: KeybindResolver
    + fullscreen_enabled: bool
    + drag_enabled: bool
    + snap_distance: ScalableValue
    --
    + deinit(alloc)
  }

  class TilingConfig <<config>> {
    + enabled: bool
    + layout: []const u8
    + layouts: ArrayList([]const u8)
    + master_side: MasterSide
    + master_width: ScalableValue
    + master_count: u8
    + gap_width: ScalableValue
    + border_width: ScalableValue
    + border_focused: Color
    + border_unfocused: Color
    + min_window_dim: u16
    + master_variant: MasterVariant
    + monocle_variant: MonocleVariant
    + grid_variant: GridVariant
    + workspace_layout_overrides
    + workspace_master_count_overrides
    + global_layout: bool
    --
    + deinit(alloc)
  }

  class BarConfig <<config>> {
    + enabled: bool
    + vim_mode: bool
    + bar_position: BarScreenPosition
    + height: ?ScalableValue
    + fonts: ArrayList([]const u8)
    + font_size: ScalableValue
    + scaled_font_size: u16
    + spacing: ScalableValue
    + bg / fg: Color
    + selected_bg / fg: Color
    + accent_color: Color
    + layout: ArrayList(BarLayout)
    + transparency: f32
    + clock_format: ?[]const u8
    + carousel_enabled: bool
    --
    + deinit(alloc)
    + scaledSegmentPadding(h): u16
    + scaledSpacing(h): u16
    + getAlpha16(): u16
  }

  class Action <<config>> {
    exec: []const u8
    close_window
    reload_config
    toggle_layout
    switch_workspace: u8
    move_to_workspace: u8
    sequence: []Action
    minimize_window
    (40+ variants total)
    --
    + deinit(alloc)
  }

  class Keybind <<config>> {
    + modifiers: u16
    + keysym: u32
    + keycode: ?u8
    + action: Action
  }

  class MouseBind <<config>> {
    + modifiers: u16
    + button: u8
    + action: Action
  }

  class KeybindResolver <<config>> {
    - map: HashMap(u64, *Action)
    - seen: HashMap(u64, usize)
    --
    + build(keybindings, xkb_state, alloc)
    + rebuildDispatchMap(keybindings, alloc)
    + lookup(mods, keysym): ?*Action
    + deinit(alloc)
  }

  class WorkspaceConfig <<config>> {
    + enabled: bool
    + count: u8
    + rules: ArrayList(Rule)
    --
    + deinit(alloc)
  }

  class BarLayout <<config>> {
    + position: BarSegmentAnchor
    + segments: ArrayList(BarSegment)
    --
    + deinit(alloc)
  }

  class ScalableValue <<config>> {
    + value: f32
    + is_percentage: bool
    --
    + percentage(v): ScalableValue
    + absolute(v): ScalableValue
  }

  enum MasterSide <<config>> {
    left
    right
  }

  enum MasterVariant <<config>> {
    lifo
    fifo
  }

  enum BarSegment <<config>> {
    workspaces
    title
    clock
    layout
    variants
  }

  enum BarSegmentAnchor <<config>> {
    left
    center
    right
  }

  enum BarScreenPosition <<config>> {
    top
    bottom
  }
}

' ══════════════════════════════════════════════════════════
' WINDOW
' ══════════════════════════════════════════════════════════
package "window" {
  class WindowState <<window>> {
    - alloc: ?Allocator
    - spawn_queue: ArrayList(SpawnEntry)
    - rules_map: StringHashMap(u8)
    - cache_slots: BoundedList(CacheSlot, 512)
    - cache_ready: bool
    - child_cache: BoundedList(ChildEntry, 64)
    - borders_flushed_this_batch: bool
    --
    + init(alloc)
    + getState(): *State
  }

  class FocusState <<window>> {
    - last_applied: ?u32
    - suppress_reason: FocusSuppressReason
    - last_event_time: u32
    - net_active_window: xcb_atom_t
    - confirm_cookie
    - confirm_win: ?u32
    - pointer_cookie
    - pre_protocols_cookie
    --
    + init() / deinit()
    + prepareFocus(win, reason)
    + prepareClearFocus()
    + applyPendingFocus(ft)
    + grabFocus(win, reason)
    + grabFocusClear()
    + grabFocusReassert(prev, steal)
    + handleFocusIn(event)
    + focusNext() / focusPrev()
    + drainPendingConfirm()
    + drainPointerSync()
    + beginTilingOpSettle()
    + drainTilingOpSettle()
  }

  class FocusTransition <<window>> {
    set: SetFocusIntent
    clear: ClearFocusIntent
    none
  }

  class SetFocusIntent <<window>> {
    + win: u32
    + old: ?u32
    + flags: CommitFlags
  }

  class CommitFlags <<window>> {
    + set_input_focus: bool
    + raise: bool
    + send_wm_take_focus: bool
    + take_focus_known: ?bool
    + arm_confirm: bool
    + schedule_bar: bool
    + new_suppress: FocusSuppressReason
  }

  enum Reason <<window>> {
    mouse_click
    mouse_enter
    pointer_sync
    user_command
    tiling_operation
    window_spawn
    workspace_switch
  }

  class WindowData <<window>> {
    + border: u32
    + hints: SizeHints
    + applied_border_width: ?u16
  }

  class WindowCache <<window>> {
    CacheMap = AutoHashMap(u32, WindowData)
    max_entries = 512
    --
    + init(alloc) / deinit()
    + cacheSizeHints(win, hints)
    + peekHints(win): SizeHints
    + cacheBorderWidth(win, w): bool
    + removeWindow(id)
    + sendBorderColorIfChanged(win, color)
  }

  class TrackingEntry <<window>> {
    + win: u32
    + mask: u64
  }

  class ActionsCtx <<window>> {
    + withdrawn_fullscreen_ws: ?WSId
    + withdrawn_was_focused: bool
  }

  class CtxActions <<window>> {
    thin action wrappers
    --
    + minimize(focused)
    + restore(win)
    + restoreOrdered(order)
    + restoreAll()
    + fullscreenToggleWindow(win)
    + moveWindowTo(win, ws_idx)
    + tagToggle(win, ws_idx, protect)
    + pinToggle(win)
    + allViewToggle()
    + toggleFloating(win)
    + dragRect(win, rect)
    + detachToFloating(win)
    + cycleLayoutKind(dir)
    + adjustMasterWidthAction(delta)
    + adjustMasterCount(delta)
    + swapMasterAction(focus_swap)
    + moveFocused(delta)
    + scrollStep(dir)
    + switchTo(ws_idx)
    + mapRequest(win, target_ws, on_current)
    + unmanage(ctx, win)
    + applyConfigReload()
  }
}

' ══════════════════════════════════════════════════════════
' TILING
' ══════════════════════════════════════════════════════════
package "tiling" {
  class Placement <<tiling>> {
    + win: WindowId
    + rect: Rect
    + visible: bool
  }

  class HintsView <<tiling>> {
    + order: []const WindowId
    + hints: []const SizeHints
    --
    + forWin(win): SizeHints
  }

  class EngineView <<tiling>> {
    + order: []const WindowId
    + params: *const LayoutParams
    + workarea: Rect
    + hints: *const HintsView
    + focused: ?WindowId
    + env: Env
  }

  class Env <<tiling>> {
    + margins: Margins
    + min_dim: u16
    + master_on_right: bool
    + grid_relaxed: bool
    + monocle_gaps: bool
  }

  class EngineList <<tiling>> {
    BoundedList(Placement, 128)
  }
}

' ══════════════════════════════════════════════════════════
' SYNC
' ══════════════════════════════════════════════════════════
package "sync" {
  class Sink <<sync>> {
    - ptr: *anyopaque
    - vt: *const VTable
    --
    + map(win)
    + geom(win, rect, stack)
    + borderWidth(win, bw)
    + borderPixel(win, pixel)
    + park(win)
    + stackOnly(win, stack)
    + flush()
    + grabServer()
    + ungrabAndFlush()
  }

  class SinkVTable <<sync>> {
    + map: fn(...)
    + geom: fn(...)
    + border_width: fn(...)
    + border_pixel: fn(...)
    + park: fn(...)
    + stack_only: fn(...)
    + flush: fn(...)
    + grab_server: fn(...)
    + ungrab_and_flush: fn(...)
  }

  class SyncCtx <<sync>> {
    + sink: Sink
    + screen: Rect
    + workarea: Rect
    + cfg_bw: u16
    + env: Env
    + color_of: fn(WindowId, *Model) u32
    + bar_win: ?WindowId
  }

  class SyncState <<sync>> {
    + sent_keys: [128]WindowId
    + sent_vals: [128]SentEntry
    + sent_count: usize
    --
    + init() / deinit()
  }

  class SentEntry <<sync>> {
    + rect: Rect
    + has_rect: bool
    + parked: bool
  }

  enum Stack <<sync>> {
    above
  }
}

' ══════════════════════════════════════════════════════════
' BAR
' ══════════════════════════════════════════════════════════
package "bar" {
  class BarState <<bar>> {
    - win: WindowCtx
    - render: RenderCtx
    - is_visible: bool
    - is_globally_visible: bool
    - is_dirty: bool
    - segment_dirty: u5
    - clock_width: u16
    - clock_x: ?u16
    - ws_count: u32
    - current_ws: u8
    - minimized: HashMap(u32, void)
    - focused_title: ArrayList(u8)
    - titles_buf
    - geoms_buf
    - fetched_len: usize
    --
    + init(...)
    + deinit()
    + markDirty()
    + markSegmentDirty(seg)
    + drawAllInner(frame)
    + scanLiveFrame(): bool
    + refreshTitleData()
    + titleSnapshot()
  }

  class WindowCtx <<bar>> {
    + conn: Connection
    + win_id: u32
    + colormap: u32
    + net_wm_name_atom: xcb_atom_t
    --
    + deinit()
  }

  class RenderCtx <<bar>> {
    + dc: *DrawContext
    + config: BarConfig
    + width: u16
    + height: u16
    + allocator: Allocator
  }

  class DrawContext <<bar>> {
    Cairo / XCB off-screen draw
    --
    + fillRect(x, y, w, h, color)
    + measureTextWidth(text): u16
    + blitRegion(x, w)
    + queueBlit()
    + deinit()
  }

  class BarAtoms <<bar>> {
    + strut_partial: xcb_atom_t
    + window_type: xcb_atom_t
    + wm_state: xcb_atom_t
    + state_above: xcb_atom_t
    + state_sticky: xcb_atom_t
    --
    + initAtoms()
  }
}

' ──────────────────────────────────────────────────────────
' RELATIONSHIPS
' ──────────────────────────────────────────────────────────

' Core
State_core --> Config : config

' Model
Model *-- StoreT : store
Model *-- WsState : ws[64]
WsState *-- LayoutParams : params
WsState *-- OrderList : tiled_order
WsState *-- MruList : focus_mru
Entry *-- Mode : mode
Entry o-- SizeHints : size_hints
Mode o-- BaseMode
Mode o-- FullscreenPayload
Mode o-- MinimizedPayload

' Config
Config *-- TilingConfig : tiling
Config *-- BarConfig : bar
Config *-- WorkspaceConfig : workspaces
Config *-- KeybindResolver : keybind_resolver
TilingConfig o-- ScalableValue : widths
TilingConfig o-- MasterVariant
BarConfig *-- BarLayout : layout
BarConfig o-- BarScreenPosition
BarConfig o-- ScalableValue
Keybind --> Action : action
MouseBind --> Action : action
KeybindResolver --> Action : refs
BarLayout o-- BarSegmentAnchor

' Window
FocusState ..> FocusTransition
CtxActions ..> Model : via pipeline
CtxActions ..> FocusTransition
WindowData *-- SizeHints : hints
WindowCache ..> WindowData : manages

' Tiling
EngineView o-- HintsView : hints
EngineView o-- LayoutParams : params
EngineView o-- Env : env
EngineList *-- Placement : contains

' Sync
SyncCtx *-- Sink : sink
SyncCtx o-- Env : env
SyncState *-- SentEntry : sent_vals
Sink *-- SinkVTable : vt

' Bar
BarState *-- WindowCtx : win
BarState *-- RenderCtx : render
RenderCtx *-- DrawContext : dc
RenderCtx ..> BarConfig : config snapshot

' Cross-layer
WindowState ..> Model : via pipeline
BarState ..> Model : via pipeline
SyncCtx ..> Model : *const Model
SyncCtx ..> Placement : compute emits
Sink ..> Placement : sends to X
SyncCtx ..> Env : reuses

' ══════════════════════════════════════════════════════════
' NOTES
' ══════════════════════════════════════════════════════════

note top of Model
  Single source of truth for window
  management state. No X11 access.
  Single-threaded; no locks needed.
end note

note top of Sink
  Vtable pattern: production wires
  XcbSink; tests wire a recorder.
  Only module that sends XCB requests.
end note

note right of Mode
  Tagged union: base | fullscreen | minimized
  Previous-mode payload is flat
  (depth <= 1)
end note

note bottom of CtxActions
  Thin action wrappers: one action =
  one model transition + one sync entry.
  Each runs under a server grab.
end note

note top of WindowCache
  Per-window border/hints cache.
  Not tiling state, shared WM infra.
  Evicted on window unmanage.
end note

@enduml
