# hana backlight write policy
#
# hana's brightness slider sub controls the panel through the kernel's own sysfs
# interface: /sys/class/backlight/<dev>/brightness (or /sys/class/leds/<dev>/
# brightness for `led:`-pinned devices). Those nodes are root-only by default,
# so unprivileged writes fail and hana falls back to spawning `brightnessctl`
# (rate-limited). This rule hands the node to the `video` group, letting hana
# commit with a single tiny write -- applied immediately, un-throttled.
#
# Install (root):
#   install -m 0644 90-hana-backlight.rules /etc/udev/rules.d/
#   udevadm control --reload && udevadm trigger
#
# Then add your user to the group and re-login (or `newgrp video`):
#   sudo usermod -aG video $USER      # then log out & back in
#
# Optional: if you prefer a different group, replace `video` below (and the
# usermod group) consistently.

# Backlight-class panels (the common path).
ACTION=="add", SUBSYSTEM=="backlight", KERNEL=="*", \
    RUN+="/usr/bin/chgrp video /sys/class/backlight/%k/brightness", \
    RUN+="/usr/bin/chmod g+w /sys/class/backlight/%k/brightness"

# LED-class devices (used only when `brightness_device` is pinned with a
# `led:` prefix, e.g. `led:kbd`).
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="*", \
    RUN+="/usr/bin/chgrp video /sys/class/leds/%k/brightness", \
    RUN+="/usr/bin/chmod g+w /sys/class/leds/%k/brightness"